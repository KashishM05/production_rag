# ── BetterDB Cloud ────────────────────────────────────────────────────────────
BETTERDB_URL=https://lolhahaha.app.betterdb.com
BETTERDB_TOKEN=

# ── Groq (LLM) ────────────────────────────────────────────────────────────────
GROQ_API_KEY=

# ── Redis  ─────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── RAG App — optional overrides (defaults shown) ────────────────────────────
GROQ_MODEL=openai/gpt-oss-120b
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CACHE_THRESHOLD=0.85
RATE_LIMIT_MINUTE=10
RATE_LIMIT_HOUR=100
CHUNK_SIZE=500
CHUNK_OVERLAP=50